# Copie ce fichier en « .env » et adapte les valeurs.

# ---------------------------------------------------------------- IA
# "mock"     : aucun modèle, réponses factices — pour vérifier l'installation
# "ollama"   : le jeu, avec l'IA locale seule
# "en_ligne" : le jeu, raconté par un service gratuit (Mistral), Ollama en secours
LLM_PROVIDER=mock

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b          # narrateur — le plus gros que ta VRAM supporte
LLM_FAST_MODEL=qwen3:4b     # utilitaire — ignoré si LLM_MODELE_UNIQUE=true
LLM_NUM_CTX=8192

# true = un seul modèle pour tout. À garder sur une carte de 8 Go : deux
# modèles qui alternent se déchargent et se rechargent deux fois par tour,
# ce qui coûte plus de temps que le petit modèle n'en fait gagner.
LLM_MODELE_UNIQUE=true
LLM_KEEP_ALIVE=30m          # garde le modèle en VRAM entre les appels
LLM_MAX_NARRATION=600       # plafond de jetons générés pour la narration
LLM_REFLEXION=false         # true = laisse le modèle produire ses blocs <think>

# --- échantillonnage. Ces cinq lignes décident de la QUALITÉ d'un modèle
# local, et elles étaient laissées au défaut d'Ollama.
#
# LLM_REPETITION est la plus importante : un modèle de 8 milliards de
# paramètres reprend ses propres tournures d'un tour à l'autre — « le silence
# se fait », « quelque chose vient de changer » — et au bout de dix tours le
# joueur reconnaît les phrases avant de les lire. 1.10 casse la boucle sans
# appauvrir le vocabulaire ; au-delà de 1.2 la syntaxe commence à se déformer.
LLM_TEMPERATURE=0.82
LLM_MIN_P=0.05
LLM_REPETITION=1.10
LLM_REPETITION_FENETRE=320
LLM_TEMPERATURE_JSON=0.1    # le JSON n'a pas à être créatif, il a à être juste

# Au-delà, on considère que le modèle est parti ou que le service ne répond
# plus. Cinq minutes d'attente sans message n'aident personne.
LLM_TIMEOUT=120

# Mesure tes vrais réglages sur TA machine :  python -m scripts.calibrer

# ------------------------------------------------------ IA en ligne
# LLM_PROVIDER=en_ligne : un service gratuit raconte, Ollama prend le relais
# dès qu'il refuse (quota, réseau, clé). Voir DEMARRER.md, section 3 bis.
# Services : mistral | gemini | groq | openrouter | lmstudio
EN_LIGNE_SERVICE=mistral
EN_LIGNE_CLE=
# EN_LIGNE_MODELE vide : le modèle conseillé du service
EN_LIGNE_MODELE=
LLM_SECOURS=ollama          # ollama | aucun
RELAIS_PAUSE=600            # quota atteint : secondes avant de réessayer

# ------------------------------------------------------------- base
DATABASE_URL=sqlite:///./data/parties.db

# ---------------------------------------------------------- mémoire
TOURS_RECENTS=6             # tours injectés mot à mot dans le contexte
RESUME_TOUS_LES=10          # fréquence des résumés de scène
BUDGET_CONTEXTE=6000        # tokens visés, contexte complet du narrateur
BUDGET_LORE=1400            # part réservée au dossier lore de la scène

# Rappel par le SENS et non par les mots : « ce que j'ai juré à Tetsuo »
# retrouve « a promis au vieux forgeron ». Demande `ollama pull
# nomic-embed-text` (~270 Mo). Sans ce modèle, le jeu retombe silencieusement
# sur le rappel lexical — voir /sante.
EMBEDDINGS=true
EMBED_MODEL=nomic-embed-text

# -------------------------------------------------- cristallisation
CRISTALLISATIONS_PAR_SESSION=3
SEUIL_COMPLET=3

# ---------------------------------------------------------- confort
# La narration arrive mot à mot au lieu d'apparaître d'un bloc. Vingt secondes
# devant un écran figé sont longues ; les mêmes vingt secondes passées à lire
# une scène qui s'écrit ne le sont pas. « false » rebascule sur le chemin
# bloquant, qui reste entièrement fonctionnel.
NARRATION_EN_FLUX=true

# ------------------------------------------------------------- voix
VOIX_ACTIVE=false
